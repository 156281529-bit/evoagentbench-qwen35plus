+package cc.eamon.open.flow.code;
+
+import cc.eamon.open.flow.core.FlowEngine;
+import cc.eamon.open.flow.core.stereotype.Flow;
+import com.alibaba.fastjson.JSON;
+import com.alibaba.fastjson.JSONArray;
+import com.alibaba.fastjson.JSONObject;
+
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.Map;
+
+/** Java nodes for the offline skill replay, driven by the existing Python TF-IDF vectors. */
+public class SkillReplayCode {
+    @Flow("SKILL_REPLAY_RETRIEVE")
+    public void retrieve(String fixture, Integer cursor) {
+        JSONObject data = JSON.parseObject(fixture);
+        JSONObject query = task(data, cursor).getJSONObject("vector");
+        JSONArray cards = data.getJSONArray("cards");
+        int bestIndex = -1;
+        double bestScore = 0.0;
+        for (int i = 0; i < cards.size(); i++) {
+            JSONObject weights = cards.getJSONObject(i).getJSONObject("vector");
+            double score = 0.0;
+            for (Map.Entry<String, Object> term : query.entrySet()) {
+                score += ((Number) term.getValue()).doubleValue() * weights.getDoubleValue(term.getKey());
+            }
+            if (score > bestScore) {
+                bestScore = score;
+                bestIndex = i;
+            }
+        }
+        FlowEngine.instance().register("memoryIndex", bestIndex).register("score", bestScore);
+    }
+
+    @Flow("SKILL_REPLAY_INJECT")
+    public void inject(String fixture, Integer cursor, Integer memoryIndex) throws NoSuchAlgorithmException {
+        JSONObject data = JSON.parseObject(fixture);
+        String prompt = task(data, cursor).getString("basePrompt");
+        if (memoryIndex >= 0) {
+            JSONObject card = data.getJSONArray("cards").getJSONObject(memoryIndex);
+            prompt += data.getString("header") + "#### " + card.getString("title") + "\n"
+                    + card.getString("description") + "\n" + card.getString("content");
+        }
+        byte[] bytes = MessageDigest.getInstance("SHA-256").digest(prompt.getBytes(StandardCharsets.UTF_8));
+        StringBuilder hash = new StringBuilder(64);
+        for (byte value : bytes) {
+            hash.append(String.format("%02x", value & 0xff));
+        }
+        FlowEngine.instance().register("promptSha256", hash.toString());
+    }
+
+    @Flow("SKILL_REPLAY_RECORD")
+    public void record(String fixture, Integer cursor, Integer memoryIndex, Double score,
+                       String promptSha256, String rows) {
+        JSONObject input = task(JSON.parseObject(fixture), cursor);
+        JSONObject row = new JSONObject(true);
+        row.put("task", input.getString("id"));
+        row.put("memoryIndex", memoryIndex);
+        row.put("score", score);
+        row.put("promptSha256", promptSha256);
+        row.put("archivedVanillaReward", input.getIntValue("archivedVanillaReward"));
+        row.put("archivedReasoningBankReward", input.getIntValue("archivedReasoningBankReward"));
+        JSONArray results = JSON.parseArray(rows);
+        results.add(row);
+        FlowEngine.instance().register("nextCursor", cursor + 1).register("updatedRows", results.toJSONString());
+    }
+
+    private static JSONObject task(JSONObject data, int cursor) {
+        return data.getJSONArray("tasks").getJSONObject(cursor);
+    }
+}
