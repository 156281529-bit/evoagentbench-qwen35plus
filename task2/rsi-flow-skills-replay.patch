+package cc.eamon.open.flow.FLOW_SKILL_REPLAY;
+
+import cc.eamon.open.flow.config.constants.FlowConstants;
+import cc.eamon.open.flow.core.FlowEngine;
+import com.alibaba.fastjson.JSON;
+import com.alibaba.fastjson.JSONArray;
+import com.alibaba.fastjson.JSONObject;
+import org.testng.Assert;
+import org.testng.SkipException;
+import org.testng.annotations.Test;
+
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Paths;
+
+public class SkillReplayTest {
+    @Test
+    public void frozenBankRetrievesAndInjectsEveryHeldOutTask() throws Exception {
+        String fixturePath = System.getProperty("rsi.skills.fixture");
+        if (fixturePath == null) {
+            throw new SkipException("Provide the locally prepared fixture via -Drsi.skills.fixture");
+        }
+        String fixture = new String(Files.readAllBytes(Paths.get(fixturePath)), StandardCharsets.UTF_8);
+        JSONObject data = JSON.parseObject(fixture);
+        JSONArray tasks = data.getJSONArray("tasks");
+        Assert.assertEquals(tasks.size(), 3);
+        Assert.assertEquals(data.getJSONArray("cards").size(), 8);
+        String scope = FlowConstants.SCOPE_DEFAULT;
+        FlowEngine engine = FlowEngine.instance();
+        JSONArray rows;
+        try {
+            engine.register(scope, "fixture", fixture).register(scope, "cursor", 0)
+                    .register(scope, "taskCount", tasks.size()).register(scope, "rows", "[]")
+                    .run("FLOW_SKILL_REPLAY_BATCH");
+            Assert.assertEquals(engine.retrieve(scope, "cursor"), Integer.valueOf(tasks.size()));
+            rows = JSON.parseArray((String) engine.retrieve(scope, "rows"));
+        } finally {
+            engine.release();
+        }
+        Assert.assertEquals(rows.size(), tasks.size());
+        for (int i = 0; i < tasks.size(); i++) {
+            JSONObject task = tasks.getJSONObject(i);
+            JSONObject row = rows.getJSONObject(i);
+            Assert.assertEquals(row.getString("task"), task.getString("id"));
+            Assert.assertEquals(row.getIntValue("memoryIndex"), task.getIntValue("expectedMemoryIndex"));
+            Assert.assertEquals(row.getDoubleValue("score"), task.getDoubleValue("expectedScore"), 0.000001);
+            Assert.assertEquals(row.getString("promptSha256"), task.getString("expectedPromptSha256"));
+            Assert.assertEquals(row.getIntValue("archivedVanillaReward"), task.getIntValue("archivedVanillaReward"));
+            Assert.assertEquals(row.getIntValue("archivedReasoningBankReward"), task.getIntValue("archivedReasoningBankReward"));
+        }
+        JSONObject evidence = new JSONObject(true);
+        evidence.put("mode", "offline_replay");
+        evidence.put("model_calls", 0);
+        evidence.put("memory_items", data.getJSONArray("cards").size());
+        evidence.put("bank_sha256", data.getString("bankSha256"));
+        evidence.put("verified_prompt_matches", rows.size());
+        evidence.put("rows", rows);
+        String output = System.getProperty("rsi.skills.output");
+        if (output != null) {
+            Files.write(Paths.get(output), (JSON.toJSONString(evidence, true) + "\n").getBytes(StandardCharsets.UTF_8));
+        }
+    }
+}
