+package cc.eamon.open.flow.FLOW_LOOP;
+
+import cc.eamon.open.flow.config.builder.flow.FlowNodeConfigBuilder;
+import cc.eamon.open.flow.config.constants.FlowConstants;
+import cc.eamon.open.flow.config.flow.FlowNodeConfig;
+import cc.eamon.open.flow.core.FlowEngine;
+import cc.eamon.open.flow.core.error.FlowLoopLimitException;
+import cc.eamon.open.flow.route.util.JexlUtils;
+import com.alibaba.fastjson.JSON;
+import org.testng.Assert;
+import org.testng.annotations.AfterMethod;
+import org.testng.annotations.Test;
+
+import java.util.Collections;
+
+public class FlowLoopTest {
+    private static final String SCOPE = FlowConstants.SCOPE_DEFAULT;
+
+    private FlowEngine start(int count, int stopAt) {
+        return FlowEngine.instance().register(SCOPE, "count", count).register(SCOPE, "stopAt", stopAt);
+    }
+
+    @AfterMethod
+    public void release() {
+        FlowEngine.instance().release();
+    }
+
+    @Test
+    public void repeatsNestedBodyAndRoutesWithLatestCount() throws Exception {
+        FlowEngine engine = start(0, 3).run("FLOW_LOOP_COUNTER");
+        Assert.assertEquals(engine.retrieve(SCOPE, "finished"), "count=3");
+        Assert.assertNull(engine.retrieve(SCOPE, "nextCount"));
+    }
+
+    @Test
+    public void falseAtEntryKeepsInitialValue() throws Exception {
+        FlowEngine engine = start(5, 3).run("FLOW_LOOP_COUNTER");
+        Assert.assertEquals(engine.retrieve(SCOPE, "finished"), "count=5");
+    }
+
+    @Test
+    public void limitStopsBeforeNextIterationAndEngineCanRunAgain() throws Exception {
+        FlowEngine engine = start(0, 4);
+        try {
+            engine.run("FLOW_LOOP_COUNTER");
+            Assert.fail("a true condition after three iterations must fail");
+        } catch (FlowLoopLimitException error) {
+            Assert.assertTrue(error.getMessage().contains("COUNT_WHILE"));
+        }
+        Assert.assertEquals(engine.retrieve(SCOPE, "count"), Integer.valueOf(3));
+        Assert.assertNull(engine.retrieve(SCOPE, "finished"));
+        start(0, 2).run("FLOW_LOOP_COUNTER");
+        Assert.assertEquals(engine.retrieve(SCOPE, "finished"), "count=2");
+    }
+
+    @Test(expectedExceptions = IllegalArgumentException.class)
+    public void nonBooleanConditionFails() {
+        JexlUtils.evaluateBoolean("1", Collections.emptyMap());
+    }
+
+    @Test
+    public void builderPreservesLoopFieldsAndEscapesExpression() {
+        FlowNodeConfig config = new FlowNodeConfigBuilder()
+                .addId("guard").addType("while").addReference("BODY")
+                .addLoopCondition("state == \"ready\"").addMaxIterations(7).build();
+        FlowNodeConfig copy = new FlowNodeConfigBuilder().addConfig(config).build();
+        FlowNodeConfig decoded = JSON.parseObject(FlowNodeConfigBuilder.toJSONString(copy), FlowNodeConfig.class);
+        Assert.assertEquals(decoded.getLoopCondition(), config.getLoopCondition());
+        Assert.assertEquals(decoded.getMaxIterations(), Integer.valueOf(7));
+    }
+}
