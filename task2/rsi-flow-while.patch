diff --git a/flow-core/src/main/java/cc/eamon/open/flow/core/stereotype/execute/WhileExecutable.java b/flow-core/src/main/java/cc/eamon/open/flow/core/stereotype/execute/WhileExecutable.java
new file mode 100644
index 0000000..ece4b23
--- /dev/null
+++ b/flow-core/src/main/java/cc/eamon/open/flow/core/stereotype/execute/WhileExecutable.java
@@ -0,0 +1,150 @@
+package cc.eamon.open.flow.core.stereotype.execute;
+
+import cc.eamon.open.flow.config.flow.FlowConfig;
+import cc.eamon.open.flow.config.flow.FlowNodeConfig;
+import cc.eamon.open.flow.config.flow.node.FlowParamConfig;
+import cc.eamon.open.flow.config.flow.node.FlowResultConfig;
+import cc.eamon.open.flow.core.context.FlowContext;
+import cc.eamon.open.flow.core.context.FlowContextHolder;
+import cc.eamon.open.flow.core.context.Initializer;
+import cc.eamon.open.flow.core.context.InitializerEnums;
+import cc.eamon.open.flow.core.error.FlowLoopLimitException;
+import cc.eamon.open.flow.core.error.FlowNotFoundException;
+import cc.eamon.open.flow.core.stereotype.execute.holder.FlowHolder;
+import cc.eamon.open.flow.model.enums.TypeEnums;
+import cc.eamon.open.flow.route.util.JexlUtils;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Set;
+
+public class WhileExecutable implements Executable {
+    private final FlowNodeConfig config;
+    private final FlowExecutable body;
+    private final int limit;
+
+    public WhileExecutable(FlowNodeConfig config) {
+        this.config = config;
+        if (config.getReference() == null || config.getReference().trim().isEmpty()) {
+            throw configurationError("reference must name the body flow");
+        }
+        if (config.getLoopCondition() == null || config.getLoopCondition().trim().isEmpty()
+                || config.getMaxIterations() == null || config.getMaxIterations() < 1) {
+            throw configurationError("loopCondition and a positive maxIterations are required");
+        }
+        if (Boolean.TRUE.equals(config.getAsync()) || config.getSchedule() != null) {
+            throw configurationError("while nodes must run synchronously");
+        }
+        this.limit = config.getMaxIterations();
+        Map<String, FlowParamConfig> inputs = new HashMap<>();
+        for (FlowParamConfig param : config.getParams()) {
+            if (inputs.put(param.getName(), param) != null) {
+                throw configurationError("loop parameter names must be unique");
+            }
+        }
+        Set<String> outputs = new HashSet<>();
+        for (FlowResultConfig result : config.getResults()) {
+            FlowParamConfig input = inputs.get(result.getName());
+            if (input == null || !Objects.equals(input.getScope(), result.getScope())
+                    || !Objects.equals(input.getType(), result.getType()) || !outputs.add(result.getName())) {
+                throw configurationError("each result must match a unique input name, scope and type");
+            }
+        }
+        body = new FlowExecutable(config);
+    }
+
+    @Override
+    public List<TypeEnums> getParamsTypes() {
+        return body.getParamsTypes();
+    }
+
+    @Override
+    public void execute() throws Exception {
+        Initializer initializer = InitializerEnums.DEFAULT.getInitializer();
+        FlowHolder holder = getBodyHolder(initializer, config.getReference());
+        if (config.getResults().size() != holder.getResults().size()) {
+            throw configurationError("the body must declare one result per loop output, in the same order");
+        }
+        Set<String> active = new HashSet<>();
+        FlowConfig owner = initializer.getFlowNodeConfigFlowConfigs().get(config);
+        if (owner != null) {
+            active.add(owner.getId());
+        }
+        validateBody(initializer, holder.getFlowConfig(), active, new HashSet<>());
+
+        FlowContext parent = FlowContextHolder.get();
+        for (int iteration = 0; condition(parent); iteration++) {
+            if (iteration == limit) {
+                throw new FlowLoopLimitException(config.getId(), limit);
+            }
+            runIteration(parent);
+        }
+    }
+
+    private boolean condition(FlowContext parent) {
+        Map<String, Object> variables = new HashMap<>();
+        for (FlowParamConfig input : config.getParams()) {
+            variables.put(input.getName(), parent.retrieveVariable(input.getScope(), input.getName()));
+        }
+        try {
+            return JexlUtils.evaluateBoolean(config.getLoopCondition(), variables);
+        } catch (RuntimeException failure) {
+            throw new IllegalArgumentException("Invalid condition for while node '" + config.getId() + "'", failure);
+        }
+    }
+
+    private void runIteration(FlowContext parent) throws Exception {
+        FlowContext iteration = new FlowContext();
+        for (FlowParamConfig input : config.getParams()) {
+            iteration.registerVariable(input.getScope(), input.getName(),
+                    parent.retrieveVariable(input.getScope(), input.getName()));
+        }
+        Map<FlowResultConfig, Object> updates = new LinkedHashMap<>();
+        FlowContextHolder.set(iteration);
+        try {
+            body.execute();
+            for (FlowResultConfig output : config.getResults()) {
+                Object value = iteration.retrieveVariables(output.getScope()).get(output.getName());
+                updates.put(output, value);
+            }
+        } finally {
+            FlowContextHolder.set(parent);
+        }
+        updates.forEach((output, value) -> parent.registerVariable(output.getScope(), output.getName(), value));
+    }
+
+    private void validateBody(Initializer initializer, FlowConfig flow, Set<String> active, Set<String> checked) {
+        if (checked.contains(flow.getId())) return;
+        if (!active.add(flow.getId())) {
+            throw configurationError("recursive flow reference in body: " + flow.getId());
+        }
+        if (flow.getSchedule() != null || flow.getStrategies().stream().anyMatch(s -> !"normal".equals(s.getStrategy()))) {
+            throw configurationError("body flows must use synchronous routing: " + flow.getId());
+        }
+        for (FlowNodeConfig node : flow.getNodes()) {
+            if (Boolean.TRUE.equals(node.getAsync()) || node.getSchedule() != null) {
+                throw configurationError("body node must be synchronous: " + node.getId());
+            }
+            if ("flow".equals(node.getType()) || "while".equals(node.getType())) {
+                FlowHolder nested = getBodyHolder(initializer, node.getReference());
+                validateBody(initializer, nested.getFlowConfig(), active, checked);
+            }
+        }
+        active.remove(flow.getId());
+        checked.add(flow.getId());
+    }
+
+    private static FlowHolder getBodyHolder(Initializer initializer, String id) {
+        FlowHolder holder = initializer.getFlowHolder(id);
+        if (holder == null) throw new FlowNotFoundException(id);
+        return holder;
+    }
+
+    private IllegalArgumentException configurationError(String message) {
+        return new IllegalArgumentException("Invalid while node '" + config.getId() + "': " + message);
+    }
+}
